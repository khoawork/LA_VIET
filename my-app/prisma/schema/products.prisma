model ProductCategory {
    id       Int        @id @default(autoincrement())
    name     String
    products Product[]

    @@map("prod_cates")
}

model Product {
    id          Int       @id @default(autoincrement())
    name        String
    description String
    image       String
    title       String
    props       Json
    slug        String    @unique
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    categoryId  Int
    category    ProductCategory @relation(fields: [categoryId], references: [id])

    @@map("products")
}
