enum Role {
    ADMIN
    MANAGER
    USER
}

model User {
    id           Int      @id @default(autoincrement())
    fullname     String
    email        String   @unique
    username     String?  @unique
    password     String
    avatar       String?
    role         Role     @default(MANAGER)
    refreshToken String?  @db.Text
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    @@map("users")
}
